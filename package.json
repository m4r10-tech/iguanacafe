{
  "name": "iguanacafe",
  "version": "1.0.0",
  "private": true,
  "description": "Nueva web de La Iguana Café (Toledo): diner americano de los años 50.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,css}\" \"*.{js,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"*.{js,json}\"",
    "check": "npm run lint && npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "vite": "^8.3.3"
  }
}
